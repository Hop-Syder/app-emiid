{
    "root": true,
    "extends": [
        "next/core-web-vitals",
        "plugin:@typescript-eslint/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": [
        "@typescript-eslint"
    ],
    "settings": {
        "next": {
            "rootDir": true
        }
    },
    "rules": {
        "@typescript-eslint/no-explicit-any": "warn",
        "@typescript-eslint/no-unused-vars": [
            "warn",
            {
                "argsIgnorePattern": "^_",
                "varsIgnorePattern": "^_"
            }
        ],
        "@typescript-eslint/no-empty-function": "error",
        "no-console": [
            "warn",
            {
                "allow": [
                    "warn",
                    "error"
                ]
            }
        ],
        "no-restricted-syntax": [
            "warn",
            {
                "selector": "CallExpression[callee.property.name='from'][arguments.0.value='user_profiles']",
                "message": "Lecture de 'user_profiles' : en contexte anonyme ou cross-user, la RLS ne renvoie que sa propre ligne. Utilise la vue 'public_profiles' ou la RPC 'get_public_profile'. Si c'est un accès authentifié à SA PROPRE ligne, ajoute 'eslint-disable-next-line no-restricted-syntax' avec justification."
            }
        ]
    },
    "ignorePatterns": [
        "node_modules/",
        ".next/",
        "out/",
        "*.test.ts",
        "*.test.tsx"
    ]
}