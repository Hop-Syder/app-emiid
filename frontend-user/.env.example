# ─────────────────────────────────────────────────────────────────────────────
# EmiID Frontend User — Variables d'environnement locales (.env.local)
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (Obligatoire) ---
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique

# --- Cloudflare Turnstile (Sécurité Captcha) ---
# Clé de SITE, publique par nature — widget utilisé par le login OAuth et la
# réauthentification par mot de passe (paramètres de sécurité).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEtVxnGegPSU9qF-
# Clé SECRÈTE — jamais commitée, jamais préfixée NEXT_PUBLIC_, et non lue par
# le code de frontend-user : c'est la protection captcha du projet Supabase
# (Auth > Attack Protection) qui la consomme pour vérifier le `captchaToken`
# transmis à signInWithPassword (cf. handleReauthSubmit). Conservée ici comme
# référence de la valeur attendue côté dashboard Supabase.
TURNSTILE_SECRET_KEY=

# --- URLs de l'application ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
