# ─────────────────────────────────────────────────────────────────────────────
# EmiID Frontend User — Variables d'environnement locales (.env.local)
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (Obligatoire) ---
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique

# --- Cloudflare Turnstile (Sécurité Captcha) ---
# Clé de SITE, publique par nature — widget dédié au domaine app.emiid.com.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEtVxnGegPSU9qF-
# Clé SECRÈTE — jamais commitée, jamais préfixée NEXT_PUBLIC_. Utilisée
# uniquement côté serveur par app/api/security/verify-captcha pour vérifier
# le jeton avant la réauthentification par mot de passe (paramètres de
# sécurité). Volontairement indépendante de la protection captcha déjà
# activée sur le projet Supabase (Auth > Attack Protection) : ce réglage est
# unique pour tout le projet et déjà apparié à la clé dédiée du back-office
# (app-admin.emiid.com) — la remplacer casserait le login admin en prod.
TURNSTILE_SECRET_KEY=

# --- URLs de l'application ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
