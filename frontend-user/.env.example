# ─────────────────────────────────────────────────────────────────────────────
# EmiID Frontend User — Variables d'environnement locales (.env.local)
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (Obligatoire) ---
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique

# --- Cloudflare Turnstile (Sécurité Captcha) ---
# Clé de site publique Turnstile (facultative en dev local si déjà définie dans le code)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEalZMK_1GPBD0mo

# --- URLs de l'application ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
