# ==============================================================================
# EmiID — Git Ignore Policy (Master)
# Organization: Nexus Partners
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env
# Exceptions : toujours versionner les modèles d'environnements
!.env.example
!**/.env.example
!.env*.example
!**/.env*.example

# Clés privées, certificats & credentials
credentials.json
.credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
service-account*.json

# ------------------------------------------------------------------------------
# Production & Build Artifacts
# ------------------------------------------------------------------------------
dist/
build/
out/
.next/
**/.next/
.turbo/
*.tsbuildinfo
**/*.tsbuildinfo

# ------------------------------------------------------------------------------
# Testing & Coverage
# ------------------------------------------------------------------------------
coverage/
**/coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/
blob-report/

# ------------------------------------------------------------------------------
# Logs & Debugging
# ------------------------------------------------------------------------------
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
eslint-report.txt*

# ------------------------------------------------------------------------------
# OS & Editor Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs & Éditeurs
.vscode/
.idea/
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Temporary Files & Caches
# ------------------------------------------------------------------------------
tmp/
temp/
.cache/
.parcel-cache/
.eslintcache

# ------------------------------------------------------------------------------
# Vercel & Cloud
# ------------------------------------------------------------------------------
.vercel/

# ------------------------------------------------------------------------------
# Local Tooling & AI Assistants
# ------------------------------------------------------------------------------
.agent/
.agents/
.agent-frontend/
.agent-saas/
.antigravity/
.claude/
.codex/
.cursor/
.cursorrules
.gemini/
.skills/
skills-lock.json
.herozionignore/
design-system/
.venv/

# Mémoire DEXTY : ignorer les fichiers temporaires mais conserver la mémoire projet
.dexty/*
!.dexty/temp-memory-projet.md
project-audit/
evaluation/
docs/
# Python bytecode
__pycache__/
*.pyc
