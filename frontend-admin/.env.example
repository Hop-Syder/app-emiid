# ─────────────────────────────────────────────────────────────────────────────
# Back-office EmiID — variables d'environnement
#
# Sans NEXT_PUBLIC_SUPABASE_ANON_KEY, Supabase répond par un 400 opaque :
#   {"hint":"No `apikey` request header or url param was found.",
#    "message":"No API key found in request"}
#
# Les variables NEXT_PUBLIC_* sont figées au moment du BUILD : les ajouter au
# tableau de bord ne suffit pas, il faut redéployer.
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (obligatoire) ---
NEXT_PUBLIC_SUPABASE_URL=https://<projet>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<clé anon publique>

# Clé service role : contourne la RLS. Strictement côté serveur — ne jamais la
# préfixer NEXT_PUBLIC_, cela l'exposerait au navigateur.
SUPABASE_SERVICE_ROLE_KEY=<clé service role>

# --- Anti-robot (Cloudflare Turnstile) ---
# La protection captcha est activée sur le projet Supabase : sans jeton,
# signInWithPassword est refusé (« captcha protection: request disallowed »).
# Clé de SITE, publique par nature. Doit correspondre au domaine du back-office
# dans le tableau de bord Cloudflare. Une valeur par défaut existe dans le code.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Liens inter-applications ---
NEXT_PUBLIC_API_URL=https://app-emiid.onrender.com
NEXT_PUBLIC_USER_APP_URL=https://app.emiid.com

# --- SMTP (campagnes e-mail du back-office) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
