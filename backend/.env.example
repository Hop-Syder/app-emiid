# Port sur lequel le serveur backend écoutera
PORT=5000

# Origines autorisées pour les requêtes CORS, séparées par des virgules
CORS_ORIGIN=http://localhost:3000,https://app-nexus-connect.vercel.app,https://app-nexus-connect-admin.vercel.app

# Configuration Supabase
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=votre_cle_anon
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role
SUPABASE_JWT_SECRET=votre_secret_jwt_32_caracteres_minimum

# Configuration Email (via Supabase SMTP)
SMTP_HOST=smtp.supabase.co
SMTP_PORT=587
SMTP_USER=postgres.xxxxxxxxxxxxxxxxxxxx
SMTP_PASS=votre_mot_de_passe_db_ou_cle_supabase
SMTP_SECURE=false
EMAIL_FROM="Nexus Connect" <no-reply@votre-domaine.com>
# Configuration Push Notifications (VAPID)
VAPID_PUBLIC_KEY=votre_cle_publique_vapid
VAPID_PRIVATE_KEY=votre_cle_privee_vapid
VAPID_SUBJECT=mailto:votre-email@domaine.com
