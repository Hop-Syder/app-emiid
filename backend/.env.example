/**
 * @author @hopsyder
 * @organization Nexus Partners
 * @description Exemple de configuration des variables d'environnement
 * @created 2026-05-07
 * 🌐 ceo.nexuspartners.xyz
*/

# Configuration du serveur
PORT=5000
NODE_ENV=development

# Supabase (OBLIGATOIRE)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_jwt_secret_min_32_chars

# CORS - URLs frontend autorisées. CORS_ORIGINS (avec S) est prioritaire si
# défini — utile pour lister plus d'origines sans toucher CORS_ORIGIN — sinon
# CORS_ORIGIN sert de repli. Le wildcard '*' est ignoré en production.
CORS_ORIGIN=http://localhost:3000,https://app.emiid.com
CORS_ORIGINS=

# URL publique de l'app (liens dans les emails transactionnels, ex. email de
# bienvenue). APP_PUBLIC_URL est prioritaire si défini, sinon repli sur APP_URL.
APP_URL=https://app.emiid.com
APP_PUBLIC_URL=

# Nombre de sauts de proxy devant le service (Render en place 1 devant l'app).
# Laisser vide en dev local (pas de proxy) ; "1" en production.
TRUST_PROXY=

# Secret partagé du webhook Supabase (header x-webhook-secret).
# Obligatoire : si vide, l'endpoint /api/webhooks/supabase renvoie 503.
# Le configurer aussi côté Supabase (Database Webhooks > HTTP Headers).
WEBHOOK_SECRET=

# Configuration Push Notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@emiid.com

# Configuration SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
EMAIL_FROM='"EmiID" <no-reply@emiid.com>'

# FedaPay (paiements Mobile Money) — requis pour activer la monétisation
# (abonnement Pro + boosts). Sans ces clés, le checkout échoue proprement
# (502, transaction FAILED) mais le serveur démarre normalement.
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_BASE_URL=

# Cache des statistiques du dashboard (ms). Optionnel, défaut 60000 (60s).
DASHBOARD_STATS_TTL_MS=

