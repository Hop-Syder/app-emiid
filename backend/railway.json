{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "installCommand": "pnpm install --no-frozen-lockfile",
    "buildCommand": "pnpm run build"
  },
  "deploy": {
    "startCommand": "pnpm start",
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 5
  }
}
