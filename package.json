{
  "name": "emiid",
  "version": "1.2.1",
  "private": true,
  "description": "EmiID — Votre empreinte numérique professionnelle",
  "scripts": {
    "dev:all": "concurrently \"npm run dev --prefix frontend-user\" \"npm run dev --prefix backend\" \"npm run dev --prefix frontend-admin\"",
    "dev:frontend": "npm run dev --prefix frontend-user",
    "dev:backend": "npm run dev --prefix backend",
    "dev:admin-old": "npm run dev --prefix admin",
    "dev:admin": "npm run dev --prefix frontend-admin",
    "postinstall": "echo 'Please run npm install in each subdirectory if needed, or use a workspace manager.'"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "sonner": "^2.0.7"
  }
}
